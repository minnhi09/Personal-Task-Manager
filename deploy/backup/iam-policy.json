{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::replace-with-private-bucket",
      "Condition": { "StringLike": { "s3:prefix": ["personal-task-manager/*"] } }
    },
    {
      "Sid": "BackupObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::replace-with-private-bucket/personal-task-manager/*"
    }
  ]
}
